# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Required - generate a random string at: https://randomkeygen.com/
SECRET_KEY=change-this-to-a-long-random-secret-string-minimum-32-chars

# Optional - set to production when deploying
FLASK_ENV=production

# Optional - Railway sets this automatically
PORT=5000

# Required on first run - the admin password (otherwise a random one is printed in the server log)
ADMIN_PASSWORD=choose-a-strong-password
